# Auto-detect text files and normalize line endings
* text=auto

# Unity YAML assets must maintain LF
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf

# Unity Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.fbx binary
*.obj binary
*.mp3 binary
*.wav binary
*.ogg binary
